{
  "presets": [ "@babel/preset-react" ],
  "plugins": [
    [
      "require.resolve(\"react-css-modules\")",
      {
        "generateScopedName": "[name]__[local]___[hash:base64:5]"
      }
    ],
    [
      "@babel/plugin-proposal-class-properties",
      {
        "loose": true
      }
    ]
  ]
}